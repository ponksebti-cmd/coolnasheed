{
  "name": "coolnasheed",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CoolNasheed — a streaming home for Islamic nasheeds: Postgres + RLS + Edge Functions on the Supabase free tier, recordings uploaded and played back in the browser, and line-by-line lyrics.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "npm run build && npm run preview",
    "typecheck": "tsc --noEmit --pretty && tsc --noEmit -p tsconfig.scripts.json --pretty",
    "lint": "npm run typecheck",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.css=empty --external:jsdom --outfile=node_modules/.tmp/smoke.cjs --log-level=warning && node node_modules/.tmp/smoke.cjs",
    "sql:bundle": "node scripts/sql-bundle.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:functions": "node scripts/setup.mjs --functions",
    "sql:test": "node scripts/pg-test.mjs",
    "verify": "npm run typecheck && npm run sql:test && npm run build && npm run smoke",
    "functions:check": "deno check --no-lock supabase/functions/*/index.ts",
    "sb:start": "supabase start",
    "sb:stop": "supabase stop",
    "sb:reset": "supabase db reset",
    "sb:link": "supabase link",
    "sb:push": "supabase db push",
    "sb:deploy": "supabase functions deploy",
    "sb:serve": "supabase functions serve",
    "sb:status": "supabase status",
    "deploy": "supabase db push && supabase functions deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
