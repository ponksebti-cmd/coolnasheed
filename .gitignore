# generated seed is committed on purpose: supabase/seed.sql is part of the project
node_modules/.tmp/

# generated by `npm run sql:bundle`: the four migrations and the seed in one file,
# for pasting into Supabase Studio when the CLI is not to hand. Generated, but
# committed on purpose — somebody setting the project up from a browser has no
# bundler to run, and a file they cannot download is a file that does not exist.
# Re-run `npm run sql:bundle` after any migration change and commit the result.
